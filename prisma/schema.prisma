// Schema do Origin.
// Referência do modelo de dados: docs/data_model.md
// Convenções: id uuid, campos em camelCase mapeados para snake_case, tabelas no plural.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catálogo (dados do admin; no MVP vêm do seed.ts)
// ---------------------------------------------------------------------------

// Linhagem (D25). NONE só aparece em skill none e no Fragmento Neutro;
// uma variante real nunca tem NONE (validado no domínio).
enum Lineage {
  FUNDAMENTAL
  ELEMENTAL
  MATERIAL
  VECTORIAL
  PSYCHIC
  BIOLOGICAL
  NONE
}

// Variante (ex.: fogo, gelo). "Sem variante" não é uma linha: o personagem
// simplesmente não tem variante ligada (docs/data_model.md, Variant).
// `awakensFromId` != nulo = variante despertada (ex.: fogo azul evolui de fogo, D67);
// mesma linhagem da base e sem despertar de despertada (validado no domínio).
model Variant {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  lineage       Lineage
  description   String?
  awakensFromId String?  @map("awakens_from_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  awakensFrom Variant?  @relation("VariantAwakening", fields: [awakensFromId], references: [id], onDelete: Restrict)
  awakenings  Variant[] @relation("VariantAwakening")

  traits    Trait[]
  templates CharacterTemplateVariant[]
  skills    Skill[]

  awakenedCharacters Character[]      @relation("CharacterAwakening")
  awakenedNpcs       NpcSquadMember[] @relation("NpcAwakening")

  @@index([awakensFromId])
  @@map("variants")
}

// Categoria do traço (D47).
enum TraitCategory {
  COMBAT
  POSTURE
  ORIGIN
}

// De onde o traço vem: TEMPLATE (modelo do personagem, ex.: família; fica na venda)
// ou CONQUERED (metas e eventos; se perde na venda).
enum TraitSource {
  TEMPLATE
  CONQUERED
}

// Traço do catálogo (D27, D39, D47). `effects` é uma lista JSON validada no domínio
// (TraitEffect); efeito é valor, não entidade (docs/data_model.md, Trait).
model Trait {
  id          String        @id @default(uuid())
  key         String        @unique
  name        String
  description String?
  category    TraitCategory
  source      TraitSource
  variantId   String?       @map("variant_id")
  effects     Json
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // só vale para esta variante (traços de família)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  familyTemplates CharacterTemplate[]
  characters      CharacterTrait[]
  npcMembers      NpcSquadMemberTrait[]
  battleFields    BattleFieldTrait[]

  @@index([variantId])
  @@map("traits")
}

// As 8 classes (D69).
enum CharacterClass {
  VANGUARD
  MARKSMAN
  EXECUTOR
  CONTROLLER
  SUPPORT
  ARTILLERY
  GUARDIAN
  TACTICIAN
}

// Raridade do modelo (D86): dificuldade de obter, não poder.
enum Rarity {
  E
  D
  C
  B
  A
  S
  SS
}

// Periculosidade (D86). O modelo define a inicial; a instância sobe.
enum DangerLevel {
  DISCRETE
  CONTINUOUS
  DIFFERENTIABLE
  NON_LINEAR
  CHAOTIC
}

// Exclusivo de evento ou ranking não vem de baú nem é vendido (D82).
enum Exclusivity {
  NONE
  EVENT
  RANKING
}

// Modelo de personagem (catálogo). Stats = perfil no nível 100, já com a distribuição
// padrão dos pontos livres (base = 85%, D91). `passive` é JSON validado no domínio.
model CharacterTemplate {
  id             String         @id @default(uuid())
  key            String         @unique
  name           String
  description    String?
  characterClass CharacterClass @map("character_class")
  rarity         Rarity
  initialDanger  DangerLevel    @map("initial_danger")
  exclusivity    Exclusivity    @default(NONE)
  familyTraitId  String?        @map("family_trait_id")
  hp             Int
  attack         Int
  defense        Int
  speed          Int
  precision      Int
  evasion        Int
  will           Int
  passive        Json
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  familyTrait Trait?                     @relation(fields: [familyTraitId], references: [id], onDelete: Restrict)
  variants    CharacterTemplateVariant[]
  characters  Character[]
  npcMembers  NpcSquadMember[]

  @@index([familyTraitId])
  @@index([characterClass])
  @@map("character_templates")
}

// Ligação modelo ↔ variante (0 a 3 por modelo; sem variante = nenhuma linha).
// `isPrimary` decide a divisão do kit básico (D97). Regras validadas no domínio.
model CharacterTemplateVariant {
  templateId String  @map("template_id")
  variantId  String  @map("variant_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  template CharacterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant  Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([templateId, variantId])
  @@index([variantId])
  @@map("character_template_variants")
}

// Tipo (força) da skill (D92).
enum SkillTier {
  BASIC
  STANDARD
  REINFORCED
  STRONG
  FINAL
}

// Quem a skill atinge. Aliado e si mesmo: sem bloqueio e sem teste de acerto.
enum SkillTarget {
  ENEMY
  ALLY
  SELF
}

// Alcance (skills_brief 11.1). Só em skill de inimigo.
enum SkillRange {
  MELEE
  RANGED
  PIERCING
  FLANK
}

// Área (D34).
enum SkillArea {
  SINGLE
  LINE
  COLUMN
  GRID
}

// Papel no kit básico (D92).
enum SkillKitSlot {
  BASIC
  STANDARD
  ROLE
  SIGNATURE
}

// Skill do catálogo. Números guardados prontos (o admin pode fugir da referência, D16);
// a referência vem de skillReference() no domínio. variantId nulo = skill none (linhagem NONE).
// Skill despertada = skill de variante despertada (Variant.awakensFromId). `effects` é JSON.
model Skill {
  id              String          @id @default(uuid())
  key             String          @unique
  name            String
  description     String?
  variantId       String?         @map("variant_id")
  tier            SkillTier
  target          SkillTarget
  range           SkillRange?
  area            SkillArea
  cooldown        Int
  desgastePercent Float           @map("desgaste_percent")
  baseHitChance   Float?          @map("base_hit_chance")
  minLevel        Int             @map("min_level")
  kitClass        CharacterClass? @map("kit_class")
  kitSlot         SkillKitSlot?   @map("kit_slot")
  effects         Json
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  characters CharacterSkill[]
  npcMembers NpcSquadMemberSkill[]

  // pool por variante (ofertas de skill) e kit por classe + variante
  @@index([variantId, minLevel])
  @@index([kitClass, variantId])
  @@map("skills")
}

// ---------------------------------------------------------------------------
// Jogador
// ---------------------------------------------------------------------------

// Conta: dona dos personagens e dos squads. Entra por username + senha (só o hash
// fica aqui). `username` já chega normalizado (minúsculo) pelo domínio. Moeda,
// inventário, organização e ranking entram com as suas camadas.
model Account {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String   @map("display_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  characters Character[]
  squads     Squad[]
  battles    Battle[]
  sessions   Session[]

  @@map("accounts")
}

// Sessão de login (refresh token com rotação). Só o hash do token fica no banco.
model Session {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("sessions")
}

// Instância do personagem (a Yuki da conta). Stats NÃO são guardados: o motor calcula a partir
// do perfil do modelo + nível + pontos livres. Pontos livres em pontos (HP: 1 ponto = 5 de HP).
model Character {
  id                String      @id @default(uuid())
  accountId         String      @map("account_id")
  templateId        String      @map("template_id")
  level             Int         @default(0)
  // XP dentro do nível atual (menor que o custo do próximo nível, D92)
  xp                Int         @default(0)
  danger            DangerLevel
  dangerPoints      Int         @default(0) @map("danger_points")
  awakenedVariantId String?     @map("awakened_variant_id")
  freeHp            Int         @default(0) @map("free_hp")
  freeAttack        Int         @default(0) @map("free_attack")
  freeDefense       Int         @default(0) @map("free_defense")
  freeSpeed         Int         @default(0) @map("free_speed")
  freePrecision     Int         @default(0) @map("free_precision")
  freeEvasion       Int         @default(0) @map("free_evasion")
  freeWill          Int         @default(0) @map("free_will")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template        CharacterTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  awakenedVariant Variant?          @relation("CharacterAwakening", fields: [awakenedVariantId], references: [id], onDelete: Restrict)
  traits          CharacterTrait[]
  skills          CharacterSkill[]
  squadMembers    SquadMember[]
  skillOffers     SkillOffer[]

  @@index([accountId])
  @@index([templateId])
  @@map("characters")
}

// Traços do personagem (até 5, D39), incluindo o de família copiado do modelo na criação (D105).
model CharacterTrait {
  characterId String   @map("character_id")
  traitId     String   @map("trait_id")
  acquiredAt  DateTime @default(now()) @map("acquired_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  trait     Trait     @relation(fields: [traitId], references: [id], onDelete: Restrict)

  @@id([characterId, traitId])
  @@index([traitId])
  @@map("character_traits")
}

// Como o personagem aprendeu a skill: kit básico (nível 0) ou oferta a cada 5 níveis (D77).
enum CharacterSkillSource {
  KIT
  OFFER
}

// Skills aprendidas pelo personagem. `buildSlot` 1 a 4 = está na build de batalha (D43);
// nulo = guardada. Único por personagem (Postgres aceita vários nulos).
model CharacterSkill {
  characterId String               @map("character_id")
  skillId     String               @map("skill_id")
  source      CharacterSkillSource
  isEnhanced  Boolean              @default(false) @map("is_enhanced")
  buildSlot   Int?                 @map("build_slot")
  acquiredAt  DateTime             @default(now()) @map("acquired_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([characterId, skillId])
  @@unique([characterId, buildSlot])
  @@index([skillId])
  @@map("character_skills")
}

// Formação salva da conta: 4 personagens dela na grade 3x3 (D11). Regras no domínio.
// Bloco de skills a cada 5 níveis (D77, D135): até 3 sorteadas, o jogador escolhe 1. Pendente = sem escolha;
// fica na fila sem prazo. As opções guardam os ids das skills (lidos junto do catálogo, como o JSON da batalha).
model SkillOffer {
  id            String    @id @default(uuid())
  characterId   String    @map("character_id")
  level         Int
  skillIds      String[]  @map("skill_ids")
  chosenSkillId String?   @map("chosen_skill_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  chosenAt      DateTime? @map("chosen_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // um bloco por nível: duas batalhas não abrem o mesmo bloco duas vezes
  @@unique([characterId, level])
  @@map("skill_offers")
}

model Squad {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members SquadMember[]
  battles Battle[]

  @@index([accountId])
  @@map("squads")
}

// Personagem numa célula do squad (D35): `row` 0 a 2 (frente para o fundo da linha),
// `column` 0 a 2 (0 = frente). Uma célula por personagem e um personagem por célula.
model SquadMember {
  squadId     String @map("squad_id")
  characterId String @map("character_id")
  row         Int
  column      Int

  squad     Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([squadId, characterId])
  @@unique([squadId, row, column])
  @@index([characterId])
  @@map("squad_members")
}

// ---------------------------------------------------------------------------
// Batalha
// ---------------------------------------------------------------------------

// Perfil da IA (D90): muda só os pesos da pontuação.
enum AiProfile {
  AGGRESSIVE
  CAUTIOUS
  FINISHER
  BALANCED
}

// Dificuldade da IA (D90): muda a qualidade da decisão, nunca dá bônus de stat.
enum AiDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MASTER
  GRANDMASTER
}

// Squad da máquina (catálogo; no MVP vem do seed.ts). Mesmas regras do jogador: 4 personagens,
// grade 3x3, 4 skills cada; nível dentro da faixa da dificuldade (D103). Regras no domínio.
model NpcSquad {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  profile     AiProfile
  difficulty  AiDifficulty
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  members NpcSquadMember[]
  battles Battle[]

  @@index([difficulty, profile])
  @@map("npc_squads")
}

// Personagem da máquina: modelo + nível + célula (+ despertar). Sem conta e sem pontos livres
// guardados (o motor usa a distribuição padrão do perfil do modelo).
model NpcSquadMember {
  id                String  @id @default(uuid())
  npcSquadId        String  @map("npc_squad_id")
  templateId        String  @map("template_id")
  level             Int
  row               Int
  column            Int
  awakenedVariantId String? @map("awakened_variant_id")

  npcSquad        NpcSquad              @relation(fields: [npcSquadId], references: [id], onDelete: Cascade)
  template        CharacterTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  awakenedVariant Variant?              @relation("NpcAwakening", fields: [awakenedVariantId], references: [id], onDelete: Restrict)
  skills          NpcSquadMemberSkill[]
  traits          NpcSquadMemberTrait[]

  @@unique([npcSquadId, templateId])
  @@unique([npcSquadId, row, column])
  @@index([templateId])
  @@map("npc_squad_members")
}

// As 4 skills de batalha do NPC, com o slot (1 a 4).
model NpcSquadMemberSkill {
  memberId  String @map("member_id")
  skillId   String @map("skill_id")
  buildSlot Int    @map("build_slot")

  member NpcSquadMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  skill  Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([memberId, skillId])
  @@unique([memberId, buildSlot])
  @@index([skillId])
  @@map("npc_squad_member_skills")
}

// Traços do NPC (até 5, incluindo o de família do modelo).
model NpcSquadMemberTrait {
  memberId String @map("member_id")
  traitId  String @map("trait_id")

  member NpcSquadMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trait  Trait          @relation(fields: [traitId], references: [id], onDelete: Restrict)

  @@id([memberId, traitId])
  @@index([traitId])
  @@map("npc_squad_member_traits")
}

// Modo da partida. No MVP só PVE (D75); os demais entram com o PvP.
enum BattleMode {
  PVE
  CASUAL
  RANKED
  FRIENDLY
}

enum BattleStatus {
  IN_PROGRESS
  FINISHED
}

enum BattleSide {
  PLAYER
  OPPONENT
}

// Eliminação, fim forçado na rodada 30 (D72) ou abandono. Sempre há vencedor.
enum BattleEndReason {
  ELIMINATION
  ROUND_LIMIT
  ABANDON
}

enum BattleActionType {
  SKILL
  MOVE
  SWAP
  DEFEND
}

// Batalha: guarda seed, snapshot dos dois lados no início e o log de decisões, NÃO o estado.
// Motor determinístico: seed + snapshot + ações = replay (D8). A seed nunca vai ao cliente (D33).
model Battle {
  id             String           @id @default(uuid())
  accountId      String           @map("account_id")
  mode           BattleMode
  status         BattleStatus     @default(IN_PROGRESS)
  squadId        String?          @map("squad_id")
  npcSquadId     String?          @map("npc_squad_id")
  aiProfile      AiProfile?       @map("ai_profile")
  aiDifficulty   AiDifficulty?    @map("ai_difficulty")
  seed           Int
  engineVersion  String           @map("engine_version")
  contentVersion String           @map("content_version")
  snapshot       Json
  winner         BattleSide?
  endReason      BattleEndReason? @map("end_reason")
  rounds         Int?
  startedAt      DateTime         @map("started_at")
  finishedAt     DateTime?        @map("finished_at")
  // XP entregue no fim (D134, D135): [{ characterId, xp, levelsGained, level, newSkillOffers }]
  rewards        Json             @default("[]")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  squad    Squad?         @relation(fields: [squadId], references: [id], onDelete: SetNull)
  npcSquad NpcSquad?      @relation(fields: [npcSquadId], references: [id], onDelete: SetNull)
  actions  BattleAction[]

  @@index([accountId, startedAt])
  @@index([npcSquadId])
  @@map("battles")
}

// Uma decisão de turno (só a entrada; o resultado o motor reproduz). `payload` é JSON
// (BattleActionPayload no domínio). `actorRef` aponta para a unidade no snapshot.
model BattleAction {
  battleId  String           @map("battle_id")
  sequence  Int
  round     Int
  side      BattleSide
  actorRef  String           @map("actor_ref")
  type      BattleActionType
  payload   Json
  createdAt DateTime         @default(now()) @map("created_at")

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@id([battleId, sequence])
  @@map("battle_actions")
}

// Os 7 stats (D45).
enum Stat {
  HP
  ATTACK
  DEFENSE
  SPEED
  PRECISION
  EVASION
  WILL
}

// Campo de batalha (catálogo do admin; no MVP vem do seed.ts). D28, D40, D98: bônus de status,
// nos dois lados, para quem tem qualquer um dos traços pedidos. Regras no domínio.
model BattleField {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  description      String?
  primaryStat      Stat     @map("primary_stat")
  secondaryStat    Stat     @map("secondary_stat")
  primaryPercent   Float    @default(6) @map("primary_percent")
  secondaryPercent Float    @default(4) @map("secondary_percent")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  requiredTraits BattleFieldTrait[]

  @@map("battle_fields")
}

// Traços pedidos pelo campo (2 a 4, de pelo menos 2 categorias).
model BattleFieldTrait {
  fieldId String @map("field_id")
  traitId String @map("trait_id")

  field BattleField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  trait Trait       @relation(fields: [traitId], references: [id], onDelete: Restrict)

  @@id([fieldId, traitId])
  @@index([traitId])
  @@map("battle_field_traits")
}
