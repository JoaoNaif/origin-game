NODE_ENV=development
PORT=3333

# Postgres — bate com o docker-compose.yml
DATABASE_URL="postgresql://origin:origin@localhost:5432/origin?schema=public"

# Front: origens liberadas no CORS (separadas por vírgula). Padrão: http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# Limite de requisições por IP. Padrão: true (os testes e2e desligam)
# RATE_LIMIT_ENABLED=true

# Validade do token de acesso (JWT). Padrão: 15m. A sessão longa vem do refresh token (30 dias).
# JWT_EXPIRES_IN=15m

# Login — par de chaves RSA (RS256) em base64, PEM PKCS8 (privada) / SPKI (pública). Gerar com:
#   npm run keys:generate     (imprime as duas linhas para colar aqui)
JWT_PRIVATE_KEY="change-me"
JWT_PUBLIC_KEY="change-me"
